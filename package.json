{
  "name": "complete",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "build-mac": "electron-builder --mac --x64",
    "build-win": "electron-builder --win --x64",
    "postinstall": "node scripts/apply-security-patches.cjs",
    "test:security": "node --test tests/cache-security.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "python-shell": "^3.0.1",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "patch-package": "8.0.1"
  },
  "build": {
    "appId": "com.yutahayashi.app",
    "files": [
      "package.json",
      "package-lock.json",
      "main.js",
      "app.py",
      "template/",
      "static/"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "http-cache-semantics": "4.3.0"
  }
}
